# Copia este archivo a `.env.local` (o configúralo en "Setup Node.js App" de DirectAdmin)
# y define el valor real ANTES de ejecutar `npm run build`.
# Esta variable se inyecta en build-time (los valores NEXT_PUBLIC_* se incrustan en el bundle).

# Google Analytics 4 — ID de medición (ej. G-XXXXXXXXXX).
# Si está vacío, el componente components/seo/Analytics.tsx no inyecta gtag.js.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
